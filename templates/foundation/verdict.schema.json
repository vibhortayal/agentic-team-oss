{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification/<issue>/verdict.json",
  "type": "object",
  "required": ["issue", "rev", "verdict", "round", "checks"],
  "properties": {
    "issue": {"type": "integer", "minimum": 1},
    "rev": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "verdict": {"enum": ["PASS", "BLOCK", "INCONCLUSIVE"]},
    "round": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "spec", "command", "result"],
        "properties": {
          "id": {"type": "string"},
          "spec": {"type": "string"},
          "command": {"type": "string"},
          "result": {"enum": ["pass", "fail", "skip", "error"]}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
